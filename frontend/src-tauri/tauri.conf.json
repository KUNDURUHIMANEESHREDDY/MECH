{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MECH Platform",
  "version": "2.1.0",
  "identifier": "com.mech.platform",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MECH Platform",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:5173 ws://localhost:5173 http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Mechanistic interpretability research platform",
    "targets": "all"
  }
}
