# Dependencies
frontend/node_modules/
.venv/
__pycache__/
*.pyc

# Build outputs
frontend/dist/
frontend/release/
frontend/*.tsbuildinfo

# Test / cache artifacts
.pytest-tmp/
.pytest_cache/
frontend/node_modules/.vitest/
frontend/test-results/
# Playwright writes a full failure dump per spec; never commit the results dir.
test-results/
playwright-report/

# Browser-automation scratch captures and ad-hoc audit scripts
.playwright-mcp/

# Local env
# Local SQLite state. backend/storage/*.db is runtime state, not source.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env

# Scratch: per-session agent continuation state
.omo/run-continuation/

# Ad-hoc debug renders written to the repo root by gpt2_steps.py etc.
/attn_*.png
/current-state*.png
/broken-state.png
/fixed-state.png
/frontend/electron-*.png
/frontend/*.log.err

# Per-run evidence records accumulate at runtime (see MECH_EVIDENCE_DIR)
backend/storage/evidence/
# Knowledge-graph runtime accumulation (see MECH_KG_PATH for isolation).
# Regenerated by GraphStore on first use, so tracking it only produced merge
# conflicts and stale snapshots. The path follows the package rename
# (backend/datasets -> backend/research_datasets); the old
# benchmark_datasets spelling no longer matches anything.
backend/research_datasets/knowledge_graph_index.json

# Plugin runtime state: installed copies, registry, audit trails.
# Plugin *sources* (library/, samples) stay tracked; installed state does not.
backend/plugins/installed/
backend/plugins/library/*/*.jsonl

# Dataset tooling run artifacts. Written by promote_dataset.py / the exporter and
# by the smoke-test audit; regenerated on demand and never an input to anything.
exports/
exports_audit/
research_demo_artifacts/
backend/research_datasets/dataset_audit.json

# Signing keys must never be committed. Nothing in the repo ships a key -- see
# backend/science/integrity/signing.py, which raises rather than defaulting one --
# but a stray PEM at a conventional path is worth ignoring as a second line of
# defence.
*.pem
*.key
!frontend/**/*.pem.example
