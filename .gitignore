# Dependencies
frontend/node_modules/
.venv/
__pycache__/
*.pyc

# Build outputs
frontend/dist/
frontend/release/
frontend/*.tsbuildinfo

# Test / cache artifacts
.pytest-tmp/
.pytest_cache/
frontend/node_modules/.vitest/
frontend/test-results/
test-results/.last-run.json

# Local env
*.db-shm
*.db-wal
.env

# Per-run evidence records accumulate at runtime (see MECH_EVIDENCE_DIR)
backend/storage/evidence/
# Knowledge-graph runtime accumulation (see MECH_KG_PATH for isolation)
# NOTE: backend/benchmark_datasets/knowledge_graph_index.json stays tracked as baseline
# The package is deliberately NOT named `datasets`: that name shadowed HuggingFace
# `datasets` whenever backend/ was on sys.path. Do not reintroduce it.
backend/datasets/

# Plugin runtime state: installed copies, registry, audit trails.
# Plugin *sources* (library/, samples) stay tracked; installed state does not.
backend/plugins/installed/
backend/plugins/library/*/*.jsonl
