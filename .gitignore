# Dependencies
frontend/node_modules/
.venv/
__pycache__/
*.pyc

# Build outputs
frontend/dist/
frontend/release/
frontend/*.tsbuildinfo

# Test / cache artifacts
.pytest-tmp*/
.pytest_cache/
frontend/node_modules/.vitest/
frontend/test-results/
# Playwright writes a full failure dump per spec; never commit the results dir.
test-results/
playwright-report/

# Browser-automation scratch captures and ad-hoc audit scripts
.playwright-mcp/

# Local env
# Local SQLite state. backend/storage/*.db is runtime state, not source.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.env

# Scratch: per-session agent continuation state
.omo/run-continuation/

# Ad-hoc debug renders written to the repo root by gpt2_steps.py etc.
/attn_*.png
/current-state*.png
/broken-state.png
/fixed-state.png
/frontend/electron-*.png
/frontend/*.log.err

# Per-run evidence records accumulate at runtime (see MECH_EVIDENCE_DIR)
backend/storage/evidence/
# Quarantined pre-envelope records (see quarantine_legacy_records)
backend/storage/evidence_historical/
# Knowledge-graph runtime accumulation (see MECH_KG_PATH for isolation).
# Regenerated by GraphStore on first use, so tracking it only produced merge
# conflicts and stale snapshots. The path follows the package rename
# (backend/datasets -> backend/research_datasets); the old
# benchmark_datasets spelling no longer matches anything.
backend/research_datasets/knowledge_graph_index.json

# SAE fit checkpoints (backend/storage/sae_checkpoints/). Written by
# `sae_pipeline._save_checkpoint` at the end of every `run()`, and never read
# back: nothing loads a checkpoint as a required input, so a missing directory
# is normal and the artifact is refitted on demand. The filename encodes the
# seed and config, so each distinct fit adds a file and they accumulate for the
# life of the checkout -- 156 files / 8.7 MB and climbing.
backend/storage/sae_checkpoints/

# Plugin runtime state: installed copies, registry, audit trails.
# Plugin *sources* (library/, samples) stay tracked; installed state does not.
backend/plugins/installed/
backend/plugins/library/*/*.jsonl

# Dataset tooling run artifacts. Written by promote_dataset.py / the exporter and
# by the smoke-test audit; regenerated on demand and never an input to anything.
exports/
exports_audit/
research_demo_artifacts/
backend/research_datasets/dataset_audit.json

# Source-export dumps (scripts/export_all_source.py). Regenerable, ~18MB total.
# The screening manifest is named after the dump it describes and sits beside it,
# so it is equally regenerable.
MECH_all_source_manifest.json
MECH_*.manifest.json
MECH_all_source.txt
MECH_backend.txt
MECH_backend_full.txt
MECH_docs_full.txt
MECH_frontend.txt
MECH_frontend_full.txt
MECH_root.txt
MECH_root_full.txt
MECH_scripts.txt
MECH_scripts_full.txt
MECH_standalone_full.txt
MECH_tests.txt
MECH_tests_full.txt
MECH_*.txt

# Standalone build copy (scripts/build_standalone.py). Regenerable.
MECH-standalone/

# Pytest scratch logs at repo root. Regenerable.
pytest_out.txt
pytest_v.txt
_pytest*.log
_pytest*.err
_t18.log

# Signing keys must never be committed. Nothing in the repo ships a key -- see
# backend/science/integrity/signing.py, which raises rather than defaulting one --
# but a stray PEM at a conventional path is worth ignoring as a second line of
# defence.
*.pem
*.key
!frontend/**/*.pem.example

# Control-plane bearer token (backend/core/auth.py). High-entropy secret for
# the trusted renderer; never commit.
.mech_api_token
backend/storage/.mech_api_token

# Publication artifacts (scripts/generate a paper). Regenerable runtime output:
# supplementary bundles, bib files and figure metadata are written here per run.
backend/science/publications/packages/
backend/science/publications/figures/

# Fitted tuned-lens translators (~27 MB of tensors per family). Regenerable:
# `python scripts/train_tuned_lens.py`. The measured report that accompanies them
# is committed instead (docs/results/tuned_lens_full_affine.json).
backend/interpretability/algorithms/translators/

# Runtime job persistence for the /api/v2 queue. Regenerable state, not source.
backend/storage/v2_jobs/

# Agent scratch: working notes and probe scripts from audit/engineering passes.
# `_team/` notes are hand-written and worth keeping locally; `_audit_scratch/` is
# throwaway probe output.
_audit_scratch/
_team/
